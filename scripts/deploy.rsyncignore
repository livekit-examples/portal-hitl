# Patterns for scripts/deploy_to_robot.sh. Same syntax as .gitignore.
#
# What's NOT in here is shipped to the robot. In particular `.env` *is*
# synced so the robot picks up your LIVEKIT_* / B601_* config
# without retype. Put per-machine overrides in `.env.local`; it's
# excluded below so each machine keeps its own.

# Version control
.git/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Recorder-side only: session archives. Neither the robot nor the
# teleoperator writes here. Multi-GB over a real collection run.
data/

# Editor/OS noise
.vscode/
.idea/
.DS_Store

# Per-machine overrides; each machine keeps its own.
.env.local

# Training artifacts stay on the training host.
checkpoints/
outputs/
