# Secrets. Anything matching .env* except the committed example.
.env
.env.*
!.env.example

# Recordings and datasets. recorder.py writes .rrd archives to
# data/recordings/ and `livekit-portal convert` writes datasets to
# data/<repo_id>/. Keep out of git; push these to HF Hub or object
# storage instead.
/data/

# Training output. policies/<algo>/train.py writes to /outputs/<RUN_NAME>/,
# which is system-root by default, but mirror the local form too in
# case anyone overrides into the repo.
/outputs/
/checkpoints/

# Scratch / vendored reference clones (e.g. tmp/molmoact2).
/tmp/

# uv / Python.
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# Lint / type-check caches.
.ruff_cache/
.mypy_cache/
.pytest_cache/

# IDE / OS.
.vscode/
.idea/
.DS_Store
.claude/
