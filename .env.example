# Copy to .env. Everything else has a default: tutorial/07-running-the-rig.md#configuration
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_ROOM=portal-hitl

# Teleop: the reBot 102 leader arm
REBOT102_LEADER_PORT=/dev/ttyUSB0

# Robot, optional: follower CAN adapter, arm and overhead cameras (Linux /dev/videoN, macOS an index such as 0)
# B601_PORT=/dev/ttyACM0
# B601_CAM_ARM=/dev/video0
# B601_CAM_OVERHEAD=/dev/video2
