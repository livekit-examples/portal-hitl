# Copy to `.env` and fill in. Per-machine overrides go in `.env.local`
# (loaded after `.env`, not synced by scripts/deploy_to_robot.sh).
#
# Hardware = Seeed reBot Arm B601-DM follower + reBot 102 leader.

# ── LiveKit wire layer (required) ───────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=portal-hitl

# Shared tick rate for robot.py / teleoperator.py / policies.
PORTAL_FPS=30

# ── B601-DM follower (robot.py host) ────────────────────────────────
# CAN bus to the Damiao motors. `damiao` = USB-serial dongle on a
# /dev/ttyACM* or /dev/ttyUSB* port; `socketcan` = a canN channel.
B601_ID=follower1
B601_PORT=/dev/ttyACM0
B601_CAN_ADAPTER=damiao
B601_DM_SERIAL_BAUD=921600

# Two RGB USB cameras: arm-mounted + overhead. Linux: /dev/videoN.
# macOS: integer index (0,1,…). Find them with `v4l2-ctl --list-devices`
# (Linux) or by trial on macOS.
B601_CAM_ARM=/dev/video0
B601_CAM_OVERHEAD=/dev/video2
B601_CAM_WIDTH=640
B601_CAM_HEIGHT=480

# ── reBot 102 leader (teleoperator.py host) ─────────────────────────
# REBOT102_LEADER_PORT is REQUIRED (no default). The wiki uses /dev/ttyUSB0.
REBOT102_LEADER_PORT=/dev/ttyUSB0
REBOT102_LEADER_ID=rebot_arm_102_leader
REBOT102_BAUDRATE=1000000
# Optional: per-joint direction signs as a JSON object, e.g.
# REBOT102_JOINT_DIRECTIONS={"gripper": -6}
# Leave unset to use the package defaults (already matched to the B601).
# REBOT102_JOINT_DIRECTIONS=

# ── Recording (teleoperator.py) ─────────────────────────────────────
PORTAL_HITL_DATASET_REPO_ID=local/portal-hitl
# PORTAL_HITL_DATASET_ROOT=/abs/path/to/dataset   # default: data/<repo_id>
PORTAL_HITL_DATASET_TASK=Grab the black cube
PORTAL_HITL_MAX_OBS_AGE_MS=100

# ── Policy inference (policies/<algo>/inference.py) ─────────────────
REBOT_TASK=Grab the black cube
# ACT_CHECKPOINT=checkpoints/act-rebot-b601/025000
# DIFFUSION_CHECKPOINT=checkpoints/diffusion-rebot-b601/025000

# ── Deploy (scripts/deploy_to_robot.sh) ─────────────────────────────
# PORTAL_HITL_ROBOT_REMOTE=robotuser@robot.local
# PORTAL_HITL_ROBOT_REMOTE_ROOT=~/workspace